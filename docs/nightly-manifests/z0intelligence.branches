# kvnloo/z0intelligence  (default: master)
# Starting manifest from the ladder plan (research/factory/ladder-plan.md §3).
# Copy to .nightly/branches on master (PR; the ruleset requires one).
# NIGHTLY_TEST_CMD: the full pytest suite exactly as .github/workflows/full-suite.yml runs it
# (branch promote/claude-code-core, matrix extras=test,quota; live tests are opt-in
# via --run-live / Z0INT_RUN_LIVE=1 and stay off). It replaces the core-unit.yml subset.
#   export UV_EXTRA_INDEX_URL=https://download.pytorch.org/whl/cpu UV_INDEX_STRATEGY=unsafe-best-match; unset Z0INT_RUN_LIVE; uv venv -q -p 3.11 --allow-existing .venv && uv pip install -q -p .venv/bin/python -e ".[test,quota]" && export PATH="$PWD/.venv/bin:$PATH" && python -m pytest -q -rs -p no:cacheprovider
# master is RED on this suite until promote/claude-code-core lands (0563ed7: 555 passed,
# 13 failed, 8 skipped), so the rebuild stops at base-red and pushes nothing. That is
# intended: land promote/claude-code-core first. See the 2026-09-30 dry runs in docs/nightly.md.
# With the memory stack merged one suite run takes ~6 min (the base alone ~1 min).
