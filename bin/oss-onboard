#!/usr/bin/env bash
# Copy the Verified OSS Loop into a repo. Never overwrites LICENSE.
# Usage:
#   oss-onboard DIR [init-oss-repo flags...]
#   oss-onboard --init [--with-automation] [--with-pages] [--labels] [--force] [--scheme rolling|staged|stable] [--layout greenfield|mature]
#   oss-onboard DIR --status
set -euo pipefail

HERE="$(cd "$(dirname "$0")/.." && pwd)"
INIT="$HERE/scripts/init-oss-repo.sh"

args=()
TARGET=""
STATUS=0
for arg in "$@"; do
  case "$arg" in
    --init)
      TARGET="$(pwd)"
      ;;
    --status)
      STATUS=1
      ;;
    -h|--help)
      sed -n '2,7p' "$0" | sed 's/^# //'
      echo
      "$INIT" --help
      exit 0
      ;;
    *)
      args+=("$arg")
      ;;
  esac
done

if [[ -z "$TARGET" ]]; then
  if [[ ${#args[@]} -eq 0 ]]; then
    echo "usage: oss-onboard DIR | oss-onboard --init | oss-onboard DIR --status" >&2
    exit 2
  fi
  TARGET="${args[0]}"
  args=("${args[@]:1}")
fi

if [[ "$STATUS" -eq 1 ]]; then
  args+=(--status)
fi

if [[ ${#args[@]} -gt 0 ]]; then
  exec "$INIT" --target "$TARGET" "${args[@]}"
fi
exec "$INIT" --target "$TARGET"
